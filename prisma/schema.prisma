// This is this app's OWN database — completely separate from Lumi Frame's
// Supabase/Postgres instance. It only stores Shopify OAuth sessions and,
// per shop, which Lumi Frame Store this shop is connected to. No try-on
// photos or results are ever stored here — those live in Lumi Frame's own
// database, reached only through its public HTTP API.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

// One row per installed shop. Links the shop to a Store record that lives
// in Lumi Frame's own database (apps/api's Tenant/Store model) — Lumi
// Frame is never queried or modified directly, only through its public
// HTTP API (app/lumiframe.server.js).
model ShopSettings {
  id             String   @id @default(cuid())
  shop           String   @unique

  // Set once, automatically, the first time this shop connects (see
  // app/routes/app.settings.jsx) — no manual key-pasting. lumiframeStoreId
  // is the PUBLIC store id the storefront widget uses directly
  // (TryOn.init({ storeId })) — it is not a secret. lumiframeEmail/
  // lumiframePassword are a machine-generated Lumi Frame login used only
  // server-side to re-authenticate (merchant JWTs expire after 7 days) when
  // this app needs to call a merchant-authenticated Lumi Frame endpoint,
  // e.g. PATCH /api/v1/store.
  lumiframeStoreId String?
  lumiframeEmail    String?
  lumiframePassword String?

  widgetColor     String   @default("#111111")
  buttonLabel     String   @default("Try On With AI")
  // Everything @lumiframe/sdk's TryOn.init() accepts for button/modal/card
  // appearance (buttonColorStart, buttonStyle, modalHeading, ...) — the
  // SDK takes these as plain init() options, it does NOT fetch them
  // itself from Lumi Frame via storeId (that was a wrong assumption in an
  // earlier version of this app). Cached here so the App Proxy's /config
  // route (read on every storefront page view) doesn't need a live,
  // authenticated call to Lumi Frame just to hand back color settings.
  widgetConfig    Json     @default("{}")
  enabled         Boolean  @default(false)
  // Name of the active Shopify Billing subscription (Starter/Brand/Agency),
  // kept in sync by app/routes/app.billing.callback.jsx and the
  // app_subscriptions/update webhook. Null = no active paid plan.
  plan            String?
  // Language THIS APP'S OWN admin screens (Dashboard/Settings/Billing) are
  // shown in for the merchant using it — see app/i18n.js. Unrelated to the
  // storefront widget's language (widgetConfig.widgetLanguage, decided per
  // shopper, not per merchant).
  adminLanguage   String   @default("en")
  // Cached count toward the free-trial limit (TRIAL_TRYON_LIMIT in
  // billing.js) for a shop with no active plan — refreshed from Lumi
  // Frame's own analytics at most every few minutes by the App Proxy
  // config route (apps.tryon.$.jsx), not on every single storefront page
  // view. Ignored once `plan` is set.
  trialTryOnsUsed      Int      @default(0)
  trialUsageCheckedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
