# ── Shopify (filled automatically by `shopify app config link` / CLI dev) ──
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products
SHOPIFY_APP_URL=https://your-app-url.example.com

# ── Session storage (this app's OWN database — separate from LumiOn) ──
# Local dev default (SQLite file). Use a Postgres URL in production.
DATABASE_URL="file:./dev.sqlite"

# ── LumiOn integration ──────────────────────────────────────────────
# Base URL of your existing, already-running LumiOn backend. This app only
# ever calls it as an external HTTP API — nothing here changes LumiOn's own
# deployment, database, or code.
LUMION_API_URL=https://lumion.onrender.com

# Per-shop LumiOn brand credentials are NOT set here — each merchant that
# installs the app connects their own LumiOn brand slug + API key from the
# app's Settings page (stored in this app's own database, not LumiOn's).
