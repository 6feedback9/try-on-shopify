# ── Shopify (filled automatically by `shopify app config link` / CLI dev) ──
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products
SHOPIFY_APP_URL=https://your-app-url.example.com

# ── Session storage (this app's OWN database — separate from Lumi Frame) ──
# Local dev default (SQLite file). Use a Postgres URL in production.
DATABASE_URL="file:./dev.sqlite"

# ── Lumi Frame integration ───────────────────────────────────────────
# Base URL of your existing, already-running Lumi Frame backend
# (6feedback9/lumiframe). This app only ever calls it as an external HTTP
# API — nothing here changes Lumi Frame's own deployment, database, or code.
LUMIFRAME_API_URL=https://lumiframe-api.onrender.com

# Per-shop Lumi Frame accounts are created automatically, server-side, the
# first time a merchant opens Settings — nothing to paste. See
# app/lumiframe.server.js and app/routes/app.settings.jsx.
