{% comment %}
  AI Glasses Try-On — product page block.
  Add via theme editor: Product template → Add block → "AI Glasses Try-On".

  This just loads Lumi Frame's own widget (@lumiframe/sdk) and hands it
  this product's real data via Liquid — no custom modal/button code lives
  in this app, Lumi Frame's SDK builds and places the button itself.
{% endcomment %}

{% liquid
  assign agto_show = true

  if block.settings.tag_filter != blank
    assign agto_show = false
    if product.tags contains block.settings.tag_filter
      assign agto_show = true
    endif
  endif

  if agto_show and block.settings.product_type_filter != blank
    if product.type != block.settings.product_type_filter
      assign agto_show = false
    endif
  endif

  assign agto_price = product.selected_or_first_available_variant.price | default: product.price
  assign agto_price = agto_price | divided_by: 100.0
%}

{% if agto_show %}
  <div
    data-agto-root
    data-product-id="{{ product.id }}"
    data-product-title="{{ product.title | escape }}"
    data-product-url="{{ product.url }}"
    data-product-image="{{ product.featured_image | image_url: width: 1200 }}"
    data-price="{{ agto_price }}"
    data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
    data-sku="{{ product.selected_or_first_available_variant.sku }}"
    data-color="{{ block.settings.accent_color }}"
    data-label="{{ block.settings.button_label | escape }}"
    {{ block.shopify_attributes }}
  ></div>
{% endif %}

{% schema %}
{
  "name": "AI Glasses Try-On",
  "target": "section",
  "javascript": "tryon-widget.js",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Try On With AI"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Only show on eyewear products"
    },
    {
      "type": "text",
      "id": "tag_filter",
      "label": "Tag filter (optional)",
      "info": "e.g. \"glasses\". If set, the button only shows on products with this tag. Leave blank to show on every product using this template."
    },
    {
      "type": "text",
      "id": "product_type_filter",
      "label": "Product type filter (optional)",
      "info": "e.g. \"Eyewear\" — must match the product's Type field exactly. Leave blank to ignore."
    }
  ]
}
{% endschema %}
